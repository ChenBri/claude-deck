{
  "name": "claude-deck-daemon",
  "version": "0.1.0",
  "description": "Ingests Claude Code hooks, scrubs and classifies them, and talks to claude-deck over the USB link.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run build",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
